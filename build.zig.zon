.{
    .name = .ermod,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xbe73ed6d75c923ff,
    .dependencies = .{},
    // No `build.zig`: this package compiles nothing (E15). What it publishes
    // is data and documentation: the generated SDK stubs, the worked
    // examples and this documentation. Nothing here is built.
    .paths = .{
        "build.zig.zon",
        "stubs",
        "examples",
        "README.md",
        "docs",
        "LICENSE",
        "NOTICE",
    },
}
